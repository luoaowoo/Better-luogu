{
  "manifest_version": 3,
  "name": "洛谷 AI 诊断助手",
  "description": "为洛谷提供提交诊断、满分复盘、同类练习、被动算法提示和文字优化。",
  "version": "0.2.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.luogu.com.cn/*", "https://luogu.com.cn/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.luogu.com.cn/*", "https://luogu.com.cn/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "洛谷 AI 诊断助手",
    "default_popup": "options.html"
  }
}
